, 0.1])\n","\n","# 3 inputs -> 4 hidden neurons\n","W1 = np.random.randn(3, 4)\n","b1 = np.random.randn(4)\n","\n","# 4 hidden neurons -> 1 output neuron\n","W2 = np.random.randn(4, 1)\n","b2 = np.random.randn(1)\n","\n","\n","# Forward Pass\n","\n","print(\"Input:\", x)\n","\n","h = hidden_to_hidden(x, W1, b1)\n","\n","output = hidden_to_output(h, W2, b2)\n","\n","print(\"\\nPredicted Output:\", output)"]},{"cell_type":"code","source":["from google.colab import drive\n","drive.mount('/content/drive')"],"metadata":{"id":"PZbqnsfX6O_k"},"execution_count":null,"outputs":[]}]}